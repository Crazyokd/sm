{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/legacy/repo/.venv/bin/sm record --agent codex --state-dir /legacy/state",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/legacy/repo/.venv/bin/sm record --agent codex --state-dir /legacy/state",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/legacy/repo/.venv/bin/sm record --agent codex --state-dir /legacy/state",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true # preserved-local-hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/legacy/repo/.venv/bin/sm record --agent codex --state-dir /legacy/state",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
