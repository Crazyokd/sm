{
  "entries": [
    {
      "target": ".codex/config.toml",
      "toml": {
        "mcp_servers": {
          "GitLab": {
            "args": [
              "-c",
              "TOKEN=$(/home/standard/.local/bin/glab config get token --host git.standard-robots.com 2>/dev/null); [ -n \"$TOKEN\" ] || exit 1; export GITLAB_PERSONAL_ACCESS_TOKEN=\"$TOKEN\"; export GITLAB_API_URL=\"http://git.standard-robots.com/api/v4\"; export GITLAB_PERMISSION_MODE=\"modify\"; export GITLAB_TOOLSETS=\"merge_requests,branches,users\"; export GITLAB_DISABLE_VERSION_CHECK=\"true\"; exec /home/standard/.nvm/versions/node/v24.11.0/bin/node /home/standard/.config/opencode/node_modules/@zereight/mcp-gitlab/build/index.js"
            ],
            "command": "bash"
          },
          "codegraph": {
            "args": [
              "serve",
              "--mcp"
            ],
            "command": "codegraph"
          },
          "cua_repl": {
            "command": "/usr/lib/chatgpt/ChatGPT",
            "enabled": false
          },
          "hermes-tools": {
            "args": [
              "-m",
              "agent.transports.hermes_tools_mcp_server"
            ],
            "command": "/home/standard/.hermes/hermes-agent/venv/bin/python3",
            "enabled": false,
            "env": {
              "HERMES_HOME": "/home/standard/.hermes",
              "HERMES_QUIET": "1",
              "HERMES_REDACT_SECRETS": "true"
            },
            "startup_timeout_sec": 30.0,
            "tool_timeout_sec": 600.0
          },
          "hindsight": {
            "args": [
              "/home/standard/.codex/plugins/cache/hindsight/hindsight-memory/0.7.4/scripts/run_mcp.sh"
            ],
            "command": "bash",
            "env": {
              "CLAUDE_PLUGIN_DATA": "/home/standard/.codex/plugins/data/hindsight-memory",
              "CLAUDE_PLUGIN_ROOT": "/home/standard/.codex/plugins/cache/hindsight/hindsight-memory/0.7.4",
              "HINDSIGHT_AGENT_NAME": "codex",
              "HINDSIGHT_API_URL": "http://127.0.0.1:8888",
              "HINDSIGHT_BANK_ID": "hermes-unified",
              "HINDSIGHT_REQUEST_TIMEOUT_SECONDS": "120"
            }
          }
        }
      }
    }
  ]
}
