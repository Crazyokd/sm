{
  "entries": [
    {
      "target": ".kimi-code/mcp.json",
      "json": {
        "mcpServers": {
          "GitLab": {
            "args": [
              "-lc",
              "TOKEN=$(glab config get token --host git.standard-robots.com); export GITLAB_PERSONAL_ACCESS_TOKEN=\"$TOKEN\"; export GITLAB_API_URL=\"http://git.standard-robots.com/api/v4\"; export GITLAB_PERMISSION_MODE=\"modify\"; export GITLAB_TOOLSETS=\"merge_requests,branches,users\"; export GITLAB_DISABLE_VERSION_CHECK=\"true\"; exec npx -y @zereight/mcp-gitlab@2.1.38"
            ],
            "command": "bash"
          },
          "codegraph": {
            "args": [
              "serve",
              "--mcp"
            ],
            "command": "codegraph",
            "startupTimeoutMs": 60000
          },
          "hindsight": {
            "args": [
              "/home/standard/.codex/plugins/cache/hindsight/hindsight-memory/0.7.4/scripts/run_mcp.sh"
            ],
            "command": "bash",
            "env": {
              "CLAUDE_PLUGIN_DATA": "/home/standard/.codex/plugins/data/hindsight-memory",
              "CLAUDE_PLUGIN_ROOT": "/home/standard/.codex/plugins/cache/hindsight/hindsight-memory/0.7.4",
              "HINDSIGHT_AGENT_NAME": "codex"
            }
          }
        }
      }
    }
  ]
}
