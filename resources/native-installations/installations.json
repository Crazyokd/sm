[
  {
    "id": "codex-ponytail-ponytail",
    "agent": "codex",
    "source": "https://github.com/DietrichGebert/ponytail.git",
    "selector": "ponytail@ponytail",
    "enabled": true,
    "paths": [
      "~/.codex/plugins/cache/ponytail/ponytail"
    ],
    "update": [
      [
        "node",
        "resources/source-providers/native-plugins.js",
        "codex",
        "https://github.com/DietrichGebert/ponytail.git",
        "ponytail@ponytail",
          "${SM_ENABLED}"
      ]
    ]
  },
